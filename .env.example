# Copy this file to .env and add your key. .env stays on your computer (it is git-ignored); never commit it.
# After editing, restart:  docker compose up -d

# One key is all it takes: an OpenRouter key (https://openrouter.ai/keys), with a few dollars of credit.
# It plans the pictures (OpenAI's gpt-5.4-mini), reads aloud (Google's Gemini storyteller, voice Charon),
# checks each recording, and draws the pictures (FLUX.2 [klein]). Without a key, the samples still play,
# and your own books get placeholders.
OPENROUTER_API_KEY=

# Optional: cheaper pictures. A Cloudflare account draws the same FLUX.2 [klein] pictures for about a tenth of
# OpenRouter's price, and its first 60 or so a day are free. The token needs the Workers AI permission.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# A limit on what your keys may spend per UTC day, in US dollars. Once reached, the voice and pictures carry on
# the next day; nothing cheaper stands in. An hour of narrated reading costs about $3.70 with OpenRouter alone
# (voice $0.81, its checks $0.54, planning $0.10, and pictures $2.22 at a new one about every 25 seconds), or
# about $1.95 with Cloudflare drawing 4 or 5 pictures a minute ($0.49).
IR_DAILY_SPEND_LIMIT_USD=5

# The port the reader opens on: http://localhost:8000
# IR_PORT=8000
